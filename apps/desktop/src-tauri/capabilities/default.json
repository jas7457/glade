{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the bundled splash page, the Vite dev server and the local Glade server (any loopback port). Only this window may use the Keychain commands (secret_*, I-134) and the notification commands (notify_*, I-135).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://127.0.0.1:*/*", "http://localhost:*", "http://localhost:*/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-theme",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-notify-permission",
    "allow-notify-request",
    "allow-notify-show",
    "allow-notify-ready",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }, { "url": "mailto:*" }]
    }
  ]
}
