{
  "name": "glade",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @glade/server dev\" \"pnpm --filter @glade/web dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @glade/server start",
    "dev:agent": "node scripts/dev-agent.mjs",
    "capture": "node tools/capture/capture.mjs",
    "test": "pnpm test:scripts && vitest run",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test",
    "tauri:dev": "pnpm --filter @glade/desktop tauri dev",
    "tauri:build": "pnpm --filter @glade/desktop tauri build --bundles app",
    "tauri:install": "node apps/desktop/scripts/install.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
